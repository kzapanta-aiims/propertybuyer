node_modules/
package-lock.json
.DS_Store

# Paper artwork downloaded by tools/import-paper-images.mjs. Scratch, and
# large: the originals are several MB each and the committed WebP crops are
# derived from them. The tool re-fetches anything missing, so nothing here
# needs keeping.
.paper-src/

# Fallback location for client success-story decks that are not committed.
# Since 8 Sep 2026 the decks themselves live in paper/decks/, committed at the
# client lead's direction; tools/extract-deck-images.mjs reads that folder
# first and this one second.
.deck-src/

# The repository root is the client folder, so these two sit inside it without
# being part of the build. They are client working files, not source, and the
# remote is not where they belong.
Brand Assets/
CRO/

# Pulled client feedback rounds, written by the client-review skill
# (/client-review pull). Working material for acting on a round; the threads
# themselves live in the feedback hub, so nothing here needs keeping.
.feedback/

# Analytics exports and saved live HTML for the location pages, read by
# tools/extract-live-inventory.mjs and by locations/PLAN.md phase 0. Inputs
# rather than source: the GSC, Semrush and Ahrefs exports carry client
# performance figures, and the saved pages are copies of the client's own
# live site. The generated inventory JSON is derived from them.
locations/data/
