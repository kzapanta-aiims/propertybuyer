{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/email-signature", "destination": "/email-signature/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/New Builds/buyer/index.html" },
    { "source": "/buyer", "destination": "/New Builds/buyer/index.html" },
    { "source": "/commercial", "destination": "/New Builds/commercial/index.html" },
    { "source": "/investor", "destination": "/New Builds/investor/index.html" },
    { "source": "/developer", "destination": "/New Builds/developer/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!locations).*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/locations/_archive/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
